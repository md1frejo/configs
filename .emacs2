(use-package affe
  :ensure t
  :bind (("C-c a" . affe-find)))

(setq affe-preview-command
      "batcat --style=numbers --color=always --line-range :200 {}")

;; lsp

(use-package vertico :ensure t :init (vertico-mode 1))
(use-package marginalia :ensure t :init (marginalia-mode))
(use-package corfu :ensure t :init (global-corfu-mode))
(use-package embark :ensure t)

(use-package lsp-mode
  :ensure t
  :hook ((python-ts-mode . lsp)
         (js-ts-mode . lsp)
         (typescript-ts-mode . lsp)))

(add-hook 'js-ts-mode-hook #'lsp)
(add-hook 'typescript-ts-mode-hook #'lsp)
(add-hook 'csetqlojure-ts-mode-hook #'lsp)

;; orderless

(use-package orderless
  :ensure t
  :custom
  (completion-styles '(orderless basic)))

(setq completion-category-overrides
      '((file (styles basic partial-completion orderless))))

(setq orderless-matching-styles
      '(orderless-prefixes orderless-regexp))

