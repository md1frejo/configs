;; ----------------------------
;; Keybindings
;; ----------------------------
(with-eval-after-load 'dired
  ;; Quick navigation & operations
  (define-key dired-mode-map (kbd "TAB") 'dired-hide-subdir)
  (when (fboundp 'diredp-up-directory-reuse-dir-buffer)
    (define-key dired-mode-map (kbd "M-b") 'diredp-up-directory-reuse-dir-buffer))
  (when (fboundp 'diredp-next-subdir)
    (define-key dired-mode-map (kbd "M-f") 'diredp-next-subdir))
  (when (fboundp 'diredp-toggle-find-file-reuse-dir)
    (define-key dired-mode-map (kbd "a") 'diredp-toggle-find-file-reuse-dir))
  (when (fboundp 'diredp-toggle-sort-by-size)
    (define-key dired-mode-map (kbd "s") 'diredp-toggle-sort-by-size))

  ;; Directory shortcut prefix map
  (define-prefix-command 'my/dired-shortcut-map)
  (define-key dired-mode-map (kbd "p") 'my/dired-shortcut-map)

  ;; Directory shortcuts
  (define-key my/dired-shortcut-map (kbd "h")
    (lambda () (interactive) (dired "~/")))
  (define-key my/dired-shortcut-map (kbd "d")
    (lambda () (interactive) (dired "~/Dropbox/")))
  (define-key my/dired-shortcut-map (kbd "p")
    (lambda () (interactive) (dired "~/Dropbox/prog/")))
  (define-key my/dired-shortcut-map (kbd "w")
    (lambda () (interactive) (dired "~/Dropbox/prog/web/")))
  (define-key my/dired-shortcut-map (kbd "e")
    (lambda () (interactive) (dired "~/.emacs.d/")))
  (define-key my/dired-shortcut-map (kbd "c")
    (lambda () (interactive) (dired "~/.config/"))))

