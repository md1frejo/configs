;; elixir setup

(defun run-elixir-code (start end)
  "Execute the selected Elixir code from START to END."
  (interactive "r")
  (let ((code (buffer-substring-no-properties start end)))
    (shell-command (concat "elixir -e \"" code "\""))))

(defun run-elixir-buffer ()
  "Execute the entire Elixir buffer."
  (interactive)
  (shell-command (concat "elixir " (buffer-file-name))))

(defun elixir-repl ()
  "Launch IEx (Interactive Elixir Shell)."
  (interactive)
  (ansi-term "iex"))

