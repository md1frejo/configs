(defvar my-themes '(modus-operandi-deuteranopia modus-vivendi doom-dracula doom-one)
  "List of themes to cycle through.")

(defvar my-current-theme nil
  "Currently active theme.")

(defun my-cycle-theme ()
  "Cycle through a list of themes in `my-themes`."
  (interactive)
  (when my-current-theme
    (disable-theme my-current-theme))
  (setq my-current-theme
        (or (cadr (member my-current-theme my-themes))
            (car my-themes)))
  (load-theme my-current-theme t)
  (message "Switched to theme: %s" my-current-theme))

;; Example keybinding
(global-set-key (kbd "C-c x") #'my-cycle-theme)

;; Add your custom theme directory
(add-to-list 'custom-theme-load-path "~/Dropbox/prog/emacs/themes/")

;; Load your theme
(load-theme 'custom-dark t)

