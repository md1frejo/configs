(defun export-installed-packages-to-org ()
  "Export a list of installed packages to an Org buffer."
  (interactive)
  (with-current-buffer (get-buffer-create "*Installed Packages*")
    (erase-buffer)
    (insert "#+TITLE: Installed Packages\n\n")
    (insert "* Package List\n")
    (dolist (pkg package-alist)
      (let ((pkg-name (symbol-name (car pkg))))
        (insert (format "- %s\n" pkg-name))))
    (org-mode)
    (write-file "~/Dropbox/prog/emacs/orgdocs/installed-packages.org")
    (message "Package list exported to ~/Dropbox/prog/emacs/orgdocs/installed-packages.org")))

(defun install-packages-from-org-file (file-path)
  "Install packages listed in an Org file at FILE-PATH."
  (interactive "fSelect Org file: ")
  (require 'package)
  (unless package-archive-contents
    (package-refresh-contents))
  (with-temp-buffer
    (insert-file-contents file-path)
    (goto-char (point-min))
    (let (package-list)
      ;; Extract package names from the list
      (while (re-search-forward "^- \\(.*\\)$" nil t)
        (push (intern (match-string 1)) package-list))
      ;; Install missing packages
      (dolist (pkg package-list)
        (unless (package-installed-p pkg)
          (package-install pkg)))
      (message "Installation completed for listed packages."))))

