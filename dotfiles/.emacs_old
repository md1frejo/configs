(defun corfu-enable-in-minibuffer ()
  "Enable Corfu completion in the minibuffer."
  (when (or (bound-and-true-p completion-in-region-mode) ;; Ensure it's active only during completion
            (minibufferp))
    (corfu-mode 1)))

(add-hook 'minibuffer-setup-hook #'corfu-enable-in-minibuffer)

;; Optionally bind `TAB` for Corfu navigation
(with-eval-after-load 'corfu
  (define-key corfu-map (kbd "TAB") #'corfu-next) ;; Navigate to the next candidate
  (define-key corfu-map (kbd "<backtab>") #'corfu-previous)) ;; Navigate to the previous candidate

(setq tab-always-indent 'complete) ;; Make `TAB` complete or indent

(setq corfu-auto-prefix 2         ;; Show suggestions after 2 characters
      corfu-auto-delay 0.1        ;; Delay before showing suggestions
      corfu-min-width 20          ;; Minimum popup width
      corfu-max-width 80          ;; Maximum popup width
      corfu-count 10              ;; Maximum number of candidates
      corfu-scroll-margin 2)      ;; Margin for scrolling in the popup

(setq completion-styles '(orderless substring basic)
      completion-category-defaults nil
      completion-category-overrides '((file (styles basic partial-completion))))

