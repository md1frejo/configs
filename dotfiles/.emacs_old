(defun custom-dired-du-size ()
  "Show total size of marked files in human-readable units (KB/MB/GB)."
  (interactive)
  (let ((files (dired-get-marked-files)))
    (with-temp-buffer
      (apply #'call-process "du" nil t nil "-ch" files)
      (message "%s" (car (last (split-string (buffer-string) "\n" t)))))))

;; Bind it inside dired
(with-eval-after-load 'dired
  (define-key dired-mode-map (kbd "z") 'custom-dired-du-size))

