;; ----------------------------
;; affe search
;; ----------------------------

(defun my-affe-find-in-directory ()
  (interactive)
  (let ((default-directory
         (read-directory-name
          "Search directory: "
          default-directory)))
    (affe-find)))

(defun my-affe-grep-in-directory ()
  (interactive)
  (let ((default-directory
         (read-directory-name
          "Search directory: "
          default-directory)))
    (affe-grep)))

(use-package affe
  :ensure t
  :bind (("C-c f" . my-affe-find-in-directory)
         ("C-c g" . my-affe-grep-in-directory)))

