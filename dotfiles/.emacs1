(use-package lsp-mode
  :ensure t
  :hook ((tsx-ts-mode . lsp)
         (typescript-ts-mode . lsp)
         (js-ts-mode . lsp))
  :commands lsp)

(use-package lsp-ui
  :ensure t
  :commands lsp-ui-mode)

(add-to-list 'custom-theme-load-path "~/Dropbox/prog/emacs/themes/")

(global-set-key
 (kbd "C-d")
 (lambda ()
   (interactive)
   (execute-kbd-macro (kbd "C-s def RET"))))

(defvar my-themes
  '(modus-operandi-deuteranopia
    modus-vivendi
    doom-dracula
    doom-one)
  "List of themes to cycle through.")

(defun my-grep4 (directory pattern)
  "Run ripgrep with clickable results in DIRECTORY."
  (interactive
   (list
    (read-directory-name "Directory: " default-directory nil t)
    (read-string "Pattern: ")))
  (let ((default-directory (expand-file-name directory))
        (compilation-environment '("TERM=dumb"))) ;; disable color escape codes
    (compilation-start
     (format "rg --line-number --no-heading --ignore-case %s ." (shell-quote-argument pattern))
     'compilation-mode))) ;; or 'compilation-mode if you want a more generic view

(defun filesearch (dir pattern)
  "Recursively search for files matching PATTERN (with wildcards, case-insensitive) starting from DIR.
Example usage: M-x my/find-files-insensitive"
  (interactive
   (list
    (read-directory-name "Directory: " default-directory)
    (read-string "Filename pattern (e.g. *.el): ")))
  (let ((cmd (format "find %s -iname '%s' -print"
                     (shell-quote-argument dir)
                     pattern)))
    (find-dired dir (concat "-iname \"" pattern "\""))))

(defun dropprog ()
  "Open the ~/Dropbox/prog/ directory. Optionally, open a subdirectory with completion."
  (interactive)
  (let* ((base-dir "~/Dropbox/prog/")
         (subdirs (directory-files base-dir nil "^[^.]" t)) ;; Get all non-hidden files and directories
         (subdir (completing-read "Subdirectory: " subdirs nil t)))
    (dired (concat base-dir subdir))))

(defun dropweb ()
  "Open the ~/Dropbox/prog/ directory. Optionally, open a subdirectory with completion."
  (interactive)
  (let* ((base-dir "~/Dropbox/prog/web/")
         (subdirs (directory-files base-dir nil "^[^.]" t)) ;; Get all non-hidden files and directories
         (subdir (completing-read "Subdirectory: " subdirs nil t)))
    (dired (concat base-dir subdir))))

(defun dropdoc ()
  "Open the ~/Dropbox/documents/various/ directory. Optionally, open a subdirectory with completion."
  (interactive)
  (let* ((base-dir "~/Dropbox/documents/various/")
         (subdirs (directory-files base-dir nil "^[^.]" t)) ;; Get all non-hidden files and directories
         (subdir (completing-read "Subdirectory: " subdirs nil t)))
    (dired (concat base-dir subdir))))


